/*-- scss:defaults --*/

// Editorial: a characterful display serif for headings, clean sans for body.
$font-family-sans-serif: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
$headings-font-family: "Fraunces", Georgia, "Times New Roman", serif;

$ink:     #1c1a17;   // warm near-black text
$muted:   #6f6a62;   // warm secondary grey
$accent:  #3730a3;   // deep indigo accent
$line:    #dde3ec;   // cool hairline borders
$wash:    #e9edf3;   // cool slate band background
$paper:   #f4f6f9;   // cool slate page background

$primary:    $accent;
$body-bg:    $paper;
$body-color: $ink;
$link-color: $accent;

$navbar-bg: $paper;
$navbar-fg: $ink;

$font-size-root: 18px;

/*-- scss:rules --*/

@import url('https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600;700&display=swap');

$ink:    #1c1a17;
$muted:  #6f6a62;
$accent: #3730a3;   // deep indigo — primary accent
$line:   #dde3ec;
$wash:   #e9edf3;
$paper:  #f4f6f9;

// Three-pillar identity colours (energy + reinforces the three identities)
$blue:   #3730a3;   // The Economist (deep indigo)
$teal:   #059669;   // The Educator & Builder (emerald green)
$coral:  #ea580c;   // The Public Voice

body {
  line-height: 1.65;
  background: $paper;
  -webkit-font-smoothing: antialiased;
  letter-spacing: -0.003em;
}

h1, h2, h3, h4, h5 {
  font-family: $headings-font-family;
  font-weight: 600;
  letter-spacing: -0.01em;
  color: $ink;
}

a { text-decoration: none; }
a:hover { text-decoration: underline; }

/* Subtle entrance motion — gives the page life on load (once, no loop). */
@keyframes fadeUp {
  from { opacity: 0; transform: translateY(16px); }
  to   { opacity: 1; transform: translateY(0); }
}
.reveal { opacity: 0; animation: fadeUp 0.7s cubic-bezier(.2,.7,.2,1) forwards; }
.reveal.d1 { animation-delay: 0.08s; }
.reveal.d2 { animation-delay: 0.16s; }
.reveal.d3 { animation-delay: 0.24s; }
.reveal.d4 { animation-delay: 0.32s; }
@media (prefers-reduced-motion: reduce) {
  .reveal { opacity: 1; animation: none; }
}

/* ---------- Navbar ---------- */
.navbar {
  border-bottom: 1px solid $line;
  box-shadow: none;
  padding-top: 0.5rem;
  padding-bottom: 0.5rem;
}
.navbar-brand {
  font-family: $headings-font-family;
  font-weight: 600;
  font-size: 1.3rem;
  letter-spacing: -0.01em;
}
.navbar .nav-link { font-weight: 500; font-size: 0.97rem; }
.navbar .nav-link:hover { color: $accent !important; }

/* ---------- Inner content pages ---------- */
.content h2 {
  font-size: 1.5rem;
  margin-top: 2.6rem;
  margin-bottom: 1rem;
  padding-bottom: 0;
  padding-left: 0.85rem;
  border: 0;
  border-left: 4px solid $accent;
  line-height: 1.25;
}
/* Rotate the heading accent colour through the three-pillar palette */
.content h2:nth-of-type(3n+1) { border-left-color: $blue; }
.content h2:nth-of-type(3n+2) { border-left-color: $teal; }
.content h2:nth-of-type(3n)   { border-left-color: $coral; }
.content h3 { font-size: 1.15rem; margin-top: 1.6rem; }
.entry-list p { margin-bottom: 0.9rem; }

.content .lead {
  font-size: 1.3rem;
  line-height: 1.5;
  font-weight: 500;
  color: $ink;
  border: 0;
  padding: 0;
  margin: 0.5rem 0 2.4rem 0;
  letter-spacing: -0.015em;
}
.content .lead strong { color: $ink; }

.nav-footer {
  border-top: 1px solid $line;
  font-size: 0.88rem;
  color: $muted;
}

/* ============================================================
   LANDING PAGE  (page-layout: custom)
   ============================================================ */

.wrap { max-width: 1080px; margin: 0 auto; padding: 0 1.5rem; }

/* --- Hero --- */
.hero-band { background: $wash; border-bottom: 1px solid $line; }
.hero {
  display: grid;
  grid-template-columns: 1.45fr 1fr;
  gap: 3.5rem;
  align-items: center;
  padding: 5.5rem 0;
}
.hero .kicker {
  text-transform: uppercase;
  letter-spacing: 0.16em;
  font-size: 0.78rem;
  font-weight: 700;
  color: $muted;
  margin-bottom: 1.1rem;
}
.hero .kicker .k1 { color: $blue; }
.hero .kicker .k2 { color: $teal; }
.hero .kicker .k3 { color: $coral; }
.hero .kicker .sep { color: #c9ccd2; }
.hero h1 {
  font-family: $headings-font-family;
  font-size: clamp(3rem, 6vw, 4.6rem);
  font-weight: 600;
  line-height: 1.0;
  letter-spacing: -0.02em;
  margin: 0 0 1.3rem 0;
}
/* Editorial flourish — a short colour bar under the name. */
.hero h1::after {
  content: "";
  display: block;
  width: 68px;
  height: 5px;
  margin-top: 1.2rem;
  background: $coral;
  border-radius: 3px;
}
.hero .lead {
  font-size: 1.27rem;
  line-height: 1.5;
  color: #3a3f48;
  font-weight: 400;
  margin-bottom: 2rem;
  letter-spacing: -0.01em;
}
.hero .lead strong { color: $ink; font-weight: 600; }
.hero-photo { position: relative; }
/* Solid offset accent block behind the photo — flat, energetic, no gradient. */
.hero-photo::before {
  content: "";
  position: absolute;
  inset: 16px -14px -14px 16px;
  z-index: 0;
  background: rgba(55, 48, 163, 0.14); /* soft indigo wash, matches the cool palette */
  border-radius: 12px;
}
.hero-photo img {
  position: relative;
  z-index: 1;
  width: 100%;
  border-radius: 12px;
  box-shadow: 0 12px 30px rgba(22, 24, 29, 0.16);
}

/* Buttons */
.btn-row { display: flex; gap: 0.7rem; flex-wrap: wrap; }
.btn-primary-cta, .btn-ghost-cta {
  display: inline-block;
  padding: 0.65rem 1.5rem;
  border-radius: 4px;
  font-weight: 600;
  font-size: 0.98rem;
  letter-spacing: -0.01em;
}
.btn-primary-cta {
  background: $blue;
  color: #fff !important;
  box-shadow: 0 6px 16px rgba(55, 48, 163, 0.28);
}
.btn-primary-cta:hover { background: #2b2682; text-decoration: none; }
.btn-ghost-cta { border: 1px solid #c9ccd2; color: $ink !important; }
.btn-ghost-cta:hover { border-color: $blue; color: $blue !important; text-decoration: none; }

/* --- Sections --- */
.section { padding: 5rem 0; }
.section.alt { background: $wash; }
.section .eyebrow {
  text-transform: uppercase;
  letter-spacing: 0.16em;
  font-size: 0.76rem;
  font-weight: 600;
  color: $accent;
  text-align: center;
  margin-bottom: 0.7rem;
}
.section h2.section-title {
  text-align: center;
  font-size: 2.4rem;
  font-weight: 600;
  letter-spacing: -0.01em;
  margin: 0 0 0.5rem 0;
  border: 0;
}
.section .section-sub {
  text-align: center;
  color: $muted;
  max-width: 600px;
  margin: 0 auto 3rem auto;
  font-size: 1.05rem;
}

/* --- Pillar cards --- */
.pillars { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.4rem; }
.pillar-card {
  position: relative;
  background: #fff;
  border: 1px solid $line;
  border-radius: 10px;
  padding: 2.2rem 1.8rem;
  overflow: hidden;
  transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
  display: block;
  color: $ink !important;
}
.pillar-card::before {
  content: "";
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 4px;
  background: var(--pc, #{$blue});
}
.pillar-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 14px 34px rgba(22, 24, 29, 0.12);
  border-color: var(--pc, #{$blue});
  text-decoration: none;
}
.pillar-card .bi {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 3.2rem; height: 3.2rem;
  font-size: 1.55rem;
  color: #fff;
  background: var(--pc, #{$blue});
  border-radius: 12px;
  box-shadow: 0 6px 16px rgba(22, 24, 29, 0.14);
}
.pillar-card h3 {
  font-size: 1.3rem;
  font-weight: 700;
  margin: 1.1rem 0 0.6rem 0;
  letter-spacing: -0.025em;
}
.pillar-card p { margin: 0 0 1.2rem 0; color: $muted; font-size: 0.98rem; }
.pillar-card .more { color: var(--pc, #{$blue}); font-weight: 600; font-size: 0.92rem; }

.pillar-card.c-blue  { --pc: #{$blue}; }
.pillar-card.c-teal  { --pc: #{$teal}; }
.pillar-card.c-coral { --pc: #{$coral}; }

/* --- Recognition spotlight (solid bold band that highlights one thing) --- */
.spotlight {
  background: $blue;
  color: #fff;
}
.spotlight .wrap { padding-top: 3.2rem; padding-bottom: 3.2rem; }
.spotlight-inner {
  display: grid;
  grid-template-columns: 1.35fr 1fr;
  align-items: center;
  gap: 2.6rem;
}
.spot-text .eyebrow {
  text-transform: uppercase;
  letter-spacing: 0.16em;
  font-size: 0.74rem;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.85);
  margin-bottom: 0.6rem;
}
.spot-text .eyebrow .bi { margin-right: 0.35rem; }
.spot-media img {
  width: 100%;
  aspect-ratio: 4 / 3;
  object-fit: cover;
  border-radius: 10px;
  box-shadow: 0 16px 40px rgba(0, 0, 0, 0.22);
  display: block;
}
.spot-text h2 {
  color: #fff;
  font-size: 1.95rem;
  font-weight: 800;
  letter-spacing: -0.03em;
  margin: 0 0 0.5rem 0;
  border: 0; padding: 0;
}
.spot-text p { color: #e9e9f7; margin: 0; font-size: 1.05rem; max-width: 640px; }
.spot-text .spot-year { color: rgba(255,255,255,0.7); font-weight: 600; }
.spot-cta {
  display: inline-block;
  margin-top: 1.3rem;
  background: #fff;
  color: #3730a3 !important;
  padding: 0.7rem 1.4rem;
  border-radius: 6px;
  font-weight: 600;
  font-size: 0.96rem;
  white-space: nowrap;
}
.spot-cta:hover { background: #f1f0fb; text-decoration: none; }

@media (max-width: 860px) {
  .spotlight-inner { grid-template-columns: 1fr; text-align: center; gap: 1.8rem; }
  .spot-text p { margin: 0 auto; }
  .spot-media { order: -1; max-width: 360px; margin: 0 auto; }
}

/* --- Featured writing --- */
.feature-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.2rem; }
.feature-card {
  background: #fff;
  border: 1px solid $line;
  border-radius: 8px;
  padding: 1.5rem;
  color: $ink !important;
  display: block;
  transition: box-shadow 0.15s ease, border-color 0.15s ease;
}
.feature-card:hover { box-shadow: 0 8px 24px rgba(22,24,29,0.08); border-color: #d3d7dd; text-decoration: none; }
.feature-card .outlet {
  text-transform: uppercase;
  letter-spacing: 0.1em;
  font-size: 0.7rem;
  font-weight: 700;
  color: $accent;
}
.feature-card h4 {
  font-size: 1.08rem;
  font-weight: 600;
  margin: 0.5rem 0 0 0;
  line-height: 1.32;
  letter-spacing: -0.02em;
}
.center-cta { text-align: center; margin-top: 2.8rem; }

/* --- Writing list (Ideas page) --- */
.writing-list { margin: 1rem 0 2rem 0; }
.writing-item {
  display: grid;
  grid-template-columns: 4.5rem 1fr;
  gap: 1.2rem;
  padding: 0.95rem 0.8rem;
  margin: 0 -0.8rem;
  border-bottom: 1px solid $line;
  align-items: baseline;
  border-radius: 5px;
  transition: background 0.12s ease;
}
.writing-item:hover { background: rgba(55, 48, 163, 0.05); }
.writing-item .yr { color: $accent; font-size: 0.9rem; font-weight: 700; font-variant-numeric: tabular-nums; }
.writing-item .ttl { font-weight: 500; color: $ink; }
.writing-item a.ttl:hover { color: $accent; }
.writing-item .tag {
  display: inline-block;
  font-size: 0.72rem;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  font-weight: 600;
  color: $accent;
  background: rgba(55, 48, 163, 0.09);
  border-radius: 999px;
  padding: 0.08rem 0.6rem;
  margin-left: 0.5rem;
  vertical-align: middle;
}

/* ============================================================
   HIRE-ME LAYER (speaking / writing / advisory positioning)
   ============================================================ */

/* Subtle availability note (academic-first; speaking/writing/advisory kept low-key) */
.avail-note { border-top: 1px solid $line; background: $paper; }
.avail-note .wrap { padding: 1.9rem 1.5rem; text-align: center; }
.avail-note p { margin: 0; color: $muted; font-size: 1rem; }
.avail-note a { color: $accent; font-weight: 600; }
.avail-note a:hover { text-decoration: underline; }

/* "As featured in" strip */
.media-strip { background: $paper; border-bottom: 1px solid $line; }
.media-strip .wrap {
  padding: 1.05rem 1.5rem;
  display: flex; gap: 0.7rem 1.3rem; align-items: baseline;
  flex-wrap: wrap; justify-content: center;
}
.media-strip .ms-label {
  text-transform: uppercase; letter-spacing: 0.16em;
  font-size: 0.72rem; font-weight: 700; color: $muted;
}
.media-strip .ms-outlets { font-family: $headings-font-family; font-size: 1.02rem; color: $ink; }

/* Closing CTA band */
.cta-band { background: $ink; color: #fff; text-align: center; }
.cta-band .wrap { padding: 3.6rem 1.5rem; }
.cta-band h2 { color: #fff; font-size: 1.85rem; margin: 0 0 0.5rem; border: 0; }
.cta-band p { color: #cfd2d8; margin: 0 0 1.6rem; }
.cta-band .btn-row { justify-content: center; }
.cta-band .btn-ghost-cta { border-color: rgba(255,255,255,0.5); color: #fff !important; }
.cta-band .btn-ghost-cta:hover { background: #fff; color: $ink !important; border-color: #fff; }

/* Inline buttons (Speaking page) */
.btn-inline, .btn-inline-ghost {
  display: inline-block; padding: 0.55rem 1.2rem;
  border-radius: 4px; font-weight: 600; font-size: 0.96rem; margin-top: 0.4rem;
}
.btn-inline { background: $accent; color: #fff !important; }
.btn-inline:hover { background: #2b2682; text-decoration: none; }
.btn-inline-ghost { border: 1px solid #c9ccd2; color: $ink !important; }
.btn-inline-ghost:hover { border-color: $accent; color: $accent !important; text-decoration: none; }

/* Callout CTA box (Speaking) */
.callout-cta {
  background: $wash; border: 1px solid $line; border-left: 4px solid $accent;
  border-radius: 8px; padding: 1.4rem 1.8rem; margin-top: 1.5rem;
}
.callout-cta h3 { margin-top: 0; }

/* Contact form */
.contact-form { max-width: 640px; margin: 1rem 0 1.5rem; }
.contact-form label { display: block; font-weight: 600; font-size: 0.92rem; margin-bottom: 1rem; color: $ink; }
.contact-form input, .contact-form select, .contact-form textarea {
  display: block; width: 100%; margin-top: 0.35rem; padding: 0.6rem 0.7rem;
  font: inherit; font-weight: 400; color: $ink; background: #fff;
  border: 1px solid #c9ccd2; border-radius: 5px;
}
.contact-form input:focus, .contact-form select:focus, .contact-form textarea:focus {
  outline: none; border-color: $accent; box-shadow: 0 0 0 3px rgba(55, 48, 163, 0.12);
}
.contact-form .cf-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
.contact-form button { margin-top: 0.3rem; border: 0; cursor: pointer; }

.muted-note { color: $muted; font-size: 0.9rem; margin-top: 2rem; }

/* --- Responsive --- */
@media (max-width: 860px) {
  .hero { grid-template-columns: 1fr; gap: 2.2rem; padding: 3.2rem 0; }
  .hero-photo { max-width: 260px; }
  .pillars, .feature-grid { grid-template-columns: 1fr; }
  .stats { grid-template-columns: repeat(2, 1fr); gap: 2rem; }
  .media-strip .wrap { justify-content: flex-start; }
  .contact-form .cf-row { grid-template-columns: 1fr; }
}

/* ============================================================
   VISUAL COMPONENTS for inner pages (graphics, stats, cards)
   ============================================================ */

/* Generic accent helpers (set the --pc custom property used below) */
.c-blue  { --pc: #{$blue}; }
.c-teal  { --pc: #{$teal}; }
.c-coral { --pc: #{$coral}; }

/* Big-number stat figures */
.stat-cards {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
  gap: 1rem;
  margin: 1.6rem 0 2.2rem;
}
.stat-figure {
  background: #fff;
  border: 1px solid $line;
  border-top: 3px solid var(--pc, #{$accent});
  border-radius: 10px;
  padding: 1.3rem 1.2rem;
}
.stat-figure .n {
  font-family: $headings-font-family;
  font-size: 1.9rem; font-weight: 700; line-height: 1.05;
  color: var(--pc, #{$accent});
}
.stat-figure .l { font-size: 0.88rem; color: $muted; margin-top: 0.4rem; line-height: 1.35; }

/* Icon cards (themes, programmes, topics) */
.icon-cards {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  gap: 1.1rem;
  margin: 1.5rem 0 2.2rem;
}
.icon-card {
  background: #fff; border: 1px solid $line; border-radius: 10px; padding: 1.4rem;
  transition: box-shadow 0.15s ease, transform 0.15s ease;
}
.icon-card:hover { box-shadow: 0 10px 26px rgba(22, 24, 29, 0.10); transform: translateY(-2px); }
.icon-card .bi {
  display: inline-flex; width: 2.7rem; height: 2.7rem;
  align-items: center; justify-content: center;
  border-radius: 9px; font-size: 1.3rem; color: #fff;
  background: var(--pc, #{$accent}); margin-bottom: 0.75rem;
  box-shadow: 0 5px 14px rgba(22, 24, 29, 0.13);
}
.icon-card h4 { font-family: $headings-font-family; font-weight: 600; margin: 0 0 0.35rem; font-size: 1.12rem; color: $ink; }
.icon-card p { margin: 0; font-size: 0.95rem; color: $muted; line-height: 1.5; }

/* Milestone timeline */
.timeline { position: relative; margin: 1.5rem 0 2.2rem; padding-left: 1.5rem; border-left: 2px solid $line; }
.timeline .tl-item { position: relative; padding: 0 0 1.4rem 0.4rem; }
.timeline .tl-item:last-child { padding-bottom: 0; }
.timeline .tl-item::before {
  content: ""; position: absolute; left: calc(-1.5rem - 1px); top: 0.3rem;
  width: 12px; height: 12px; border-radius: 50%;
  background: var(--pc, #{$accent}); box-shadow: 0 0 0 4px $paper;
}
.timeline .tl-when { font-size: 0.78rem; font-weight: 700; letter-spacing: 0.04em; color: var(--pc, #{$accent}); text-transform: uppercase; }
.timeline .tl-what { font-size: 1rem; color: $ink; margin-top: 0.1rem; }
.timeline .tl-what strong { font-weight: 600; }

/* Pull quote */
.pullquote {
  font-family: $headings-font-family; font-weight: 500;
  font-size: 1.55rem; line-height: 1.4; color: $ink;
  border-left: 4px solid $accent; padding: 0.2rem 0 0.2rem 1.4rem; margin: 2.2rem 0;
}

/* Partner / affiliation badges */
.badges { display: flex; flex-wrap: wrap; gap: 0.6rem; margin: 1.1rem 0 2rem; }
.badge-chip {
  display: inline-block; padding: 0.45rem 0.95rem; border: 1px solid $line;
  border-radius: 999px; background: #fff; font-size: 0.9rem; font-weight: 600; color: $ink;
}

/* Figure box (charts) */
.figure-box { background: #fff; border: 1px solid $line; border-radius: 10px; padding: 1.5rem 1.6rem; margin: 1.6rem 0 2.2rem; }
.figure-box .fig-title { font-family: $headings-font-family; font-weight: 600; font-size: 1.05rem; color: $ink; margin: 0 0 1rem; }
.figure-box .cap { font-size: 0.82rem; color: $muted; margin-top: 0.9rem; }

/* Simple horizontal bar chart */
.barchart .bar-row { display: grid; grid-template-columns: 7rem 1fr 2.6rem; align-items: center; gap: 0.8rem; margin: 0.65rem 0; }
.barchart .bar-label { font-size: 0.9rem; color: $ink; }
.barchart .bar-track { display: block; background: $wash; border-radius: 6px; height: 1.6rem; overflow: hidden; }
.barchart .bar-fill { display: block; height: 100%; border-radius: 6px; background: var(--pc, #{$accent}); transition: width 0.6s ease; }
.barchart .bar-val { font-weight: 700; font-size: 0.92rem; color: var(--pc, #{$accent}); text-align: right; }

/* Floated portrait (About) */
.about-portrait {
  float: right; width: 210px; border-radius: 10px;
  margin: 0.2rem 0 1rem 1.6rem; box-shadow: 0 12px 28px rgba(22, 24, 29, 0.16);
}

@media (max-width: 700px) {
  .about-portrait { float: none; display: block; width: 60%; margin: 0 auto 1.5rem; }
  .barchart .bar-row { grid-template-columns: 5.5rem 1fr 2.4rem; }
}

/* ============================================================
   REAL-IMAGE COMPONENTS (press gallery, figures)
   ============================================================ */

/* "In the press" gallery of clippings / screenshots */
.press-gallery {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
  gap: 1.1rem;
  margin: 1.5rem 0 2.2rem;
}
.press-item {
  display: block; background: #fff; border: 1px solid $line;
  border-radius: 9px; overflow: hidden; color: $ink !important;
  transition: box-shadow 0.18s ease, transform 0.18s ease;
}
.press-item:hover { box-shadow: 0 12px 28px rgba(22,24,29,0.14); transform: translateY(-3px); text-decoration: none; }
.press-item .pc-img { height: 210px; overflow: hidden; background: $wash; border-bottom: 1px solid $line; }
.press-item .pc-img img { width: 100%; height: 100%; object-fit: cover; object-position: top center; display: block; }
.press-item .pc-cap { padding: 0.7rem 0.85rem; }
.press-item .pc-cap .pc-outlet { font-size: 0.68rem; text-transform: uppercase; letter-spacing: 0.1em; font-weight: 700; color: $accent; }
.press-item .pc-cap .pc-title { display: block; font-family: $headings-font-family; font-size: 0.98rem; color: $ink; margin-top: 0.15rem; line-height: 1.25; }

/* Captioned media figure (event photos, broadcast screenshots) */
.media-figure { margin: 1.6rem 0 2rem; }
.media-figure img { width: 100%; border-radius: 10px; border: 1px solid $line; display: block; box-shadow: 0 10px 24px rgba(22,24,29,0.12); }
.media-figure figcaption { font-size: 0.85rem; color: $muted; margin-top: 0.6rem; }

/* Right-floated figure (report covers, etc.) */
.figure-right { float: right; width: 230px; margin: 0.3rem 0 1.1rem 1.6rem; }
.figure-right img { width: 100%; border-radius: 9px; border: 1px solid $line; display: block; box-shadow: 0 10px 24px rgba(22,24,29,0.14); }
.figure-right figcaption { font-size: 0.8rem; color: $muted; margin-top: 0.5rem; text-align: center; }

@media (max-width: 700px) {
  .figure-right { float: none; width: 70%; margin: 0 auto 1.4rem; }
}
